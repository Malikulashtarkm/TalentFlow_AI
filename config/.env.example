LOCAL_HF_DEVICE=-1
LOCAL_HF_MAX_NEW_TOKENS=600
LOCAL_AGENT_SPEED_MODE=fast
LOCAL_ALLOW_SLOW_LLM=false
LOCAL_FIRST_CONFIDENCE=0.10
